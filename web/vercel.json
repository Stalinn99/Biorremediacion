{
  "headers": [
    {
      "source": "/simulador/Build/(.*)\\.br$",
      "headers": [
        { "key": "Content-Encoding", "value": "br" }
      ]
    },
    {
      "source": "/simulador/Build/(.*)\\.gz$",
      "headers": [
        { "key": "Content-Encoding", "value": "gzip" }
      ]
    },
    {
      "source": "/simulador/Build/(.*)\\.wasm$",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" }
      ]
    }
  ]
}
